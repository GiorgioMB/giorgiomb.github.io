@article{micaletto2026scalable,
  abbr            = {arXiv},
  bibtex_show     = {true},
  title           = {From Proxy to Certificate: Two-Sided {Ollivier-Ricci} Bounds from Balanced {Forman} Curvature},
  author          = {Micaletto, Giorgio and Nigrelli, Tebe},
  journal         = {arXiv preprint arXiv:2603.13535},
  year            = {2026},
  arxiv           = {2603.13535v6},
  code            = {https://github.com/GiorgioMB/Curvature-Transfer-Code},
  lean            = {https://github.com/GiorgioMB/BF-OR-Lean},
  demo            = {/projects/screening-map/},
  preview         = {proxy-to-certificate.png},
  additional_info = {. An earlier version, *Scalable Graph Curvature: Bounding Ollivier-Ricci via Local Combinatorics for Geometric Deep Learning*, was accepted (non-archival) at the NeurIPS Workshop on Geometric Distributional Deep Learning},
  abstract        = {Balanced Forman (BF) curvature is used in graph learning as a cheap stand-in for Ollivier-Ricci (OR) curvature, yet it does not lower-bound OR curvature. We show that the BF value of an edge certifies a two-sided interval for its lazy OR curvature without solving any optimal transport problem, that BF coincides with a quadrangle-augmented Jost-Liu (JL) bound with its positive parts removed, and that when the 2-hop neighborhood is available, the interval can be sharpened at a cost of order the maximum degree to the power 2.5 per edge. On 23 benchmark graphs, our quadrangle-augmented bound is tighter than the bounds of JL and Tian-Lubberts-Weber (TLW) on 13.8-100\% of the edges and reduces their mean gap to the exact curvature by a median of 31.2\%; intersected with the bounds of TLW, the intervals settle the curvature sign of more than half of the edges on 21 of the 23 graphs. On 15 real networks with up to 1,049,866 edges, a certify-then-solve procedure answers sign queries exactly while solving a median of 5.9 times fewer transport problems, for median speedups of 2 times over exact evaluation, measured against a min-cut solver that is itself about two orders of magnitude faster than the widely used GraphRicciCurvature. The main results are machine-checked in Lean 4.},
  selected        = {true}
}

@article{micaletto2025bridge,
  abbr            = {arXiv},
  bibtex_show     = {true},
  title           = {Bridge Sampling Diagnostics},
  author          = {Micaletto, Giorgio and Vehtari, Aki},
  journal         = {arXiv preprint arXiv:2508.14487},
  year            = {2025},
  arxiv           = {2508.14487},
  code            = {https://github.com/GiorgioMB/bridgesampling_paper_code},
  preview         = {bridge-sampling-diagnostics.png},
  abstract        = {In Bayesian statistics, the marginal likelihood is used for model selection and averaging, yet it is often challenging to compute accurately for complex models. Approaches such as bridge sampling, while effective, suffer from high variance when the proposal distribution overlaps poorly with the target posterior. To quantify this variance, we present a closed-form Monte Carlo standard error (MCSE) estimator for bridge sampling, extending classical variance approximations with a multi-chain effective-sample-size correction for autocorrelated MCMC draws and an exact log-scale variance. We show that the MCSE estimate itself is structurally capped at about 1.05, so values near this cap signal saturation rather than precision, and our calibration experiments show that the MCSE can be trusted when it is below 0.3. Furthermore, we introduce a hybrid score-matching proposal that regularizes the sample covariance using the local posterior geometry, significantly improving the stability of the estimator, and we demonstrate the efficacy of these methods using increasingly difficult simulated posteriors and real posteriors from the posteriordb database.},
  selected        = {true}
}
